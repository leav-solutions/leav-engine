{
    "name": "@leav/app-root-path",
    "version": "1.18.0",
    "description": "Module to get app root path",
    "scripts": {
        "test": "vitest run -c vitest.config.ts",
        "test:ci": "vitest run -c vitest.config.ts --maxWorkers=2 --reporter=verbose",
        "test:commit": "vitest run -c vitest.config.ts --changed",
        "prepublishOnly": "npm run build",
        "build": "tsc --build tsconfig.build.json",
        "clean": "rm -rf dist dist-spec tsconfig.build.tsbuildinfo tsconfig.spec.tsbuildinfo",
        "tscheck": "tsc -b tsconfig.build.json && tsc --noEmit -p tsconfig.spec.json",
        "tscheck:watch": "tsc -b -w tsconfig.json"
    },
    "main": "dist/index",
    "keywords": [
        "config",
        "configuration",
        "settings"
    ],
    "author": "",
    "license": "LGPL3",
    "devDependencies": {
        "@types/node": "24.13.3",
        "prettier": "3.9.5",
        "typescript": "6.0.3",
        "vitest": "4.1.10"
    },
    "dependencies": {
        "app-root-path": "3.1.0"
    },
    "stableVersion": "1.0.0"
}
