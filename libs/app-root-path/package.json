{
    "name": "@leav/app-root-path",
    "version": "1.9.0",
    "description": "Module to get app root path",
    "scripts": {
        "test": "jest -c jest-config.json",
        "test:ci": "jest -c jest-config.json --maxWorkers=2",
        "test:commit": "jest -c jest-config.json --maxWorkers=50% --onlyChanged ",
        "prepublishOnly": "npm run build",
        "build": "tsc --build tsconfig.build.json",
        "tscheck": "tsc --noEmit -p .",
        "tscheck:watch": "tsc -w --noEmit -p ."
    },
    "main": "dist/index",
    "keywords": [
        "config",
        "configuration",
        "settings"
    ],
    "author": "",
    "license": "LGPL3",
    "devDependencies": {
        "@types/jest": "29.5.14",
        "jest": "29.7.0",
        "prettier": "3.3.3",
        "ts-jest": "29.4.6",
        "typescript": "5.9.3"
    },
    "dependencies": {
        "app-root-path": "3.1.0"
    },
    "stableVersion": "1.0.0"
}
