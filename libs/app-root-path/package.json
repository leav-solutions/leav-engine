{
    "name": "@leav/app-root-path",
    "version": "1.12.0",
    "description": "Module to get app root path",
    "scripts": {
        "test": "vitest run -c vitest.config.ts",
        "test:ci": "vitest run -c vitest.config.ts --maxWorkers=2 --reporter=verbose",
        "test:commit": "vitest run -c vitest.config.ts --changed",
        "prepublishOnly": "npm run build",
        "build": "tsc --build tsconfig.build.json",
        "tscheck": "tsc --noEmit -p .",
        "tscheck:watch": "tsc -w --noEmit -p ."
    },
    "main": "dist/index",
    "keywords": [
        "config",
        "configuration",
        "settings"
    ],
    "author": "",
    "license": "LGPL3",
    "devDependencies": {
        "prettier": "3.3.3",
        "typescript": "5.9.3",
        "vitest": "4.1.5"
    },
    "dependencies": {
        "app-root-path": "3.1.0"
    },
    "stableVersion": "1.0.0"
}
