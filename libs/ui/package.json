{
    "name": "@leav/ui",
    "version": "1.6.0",
    "description": "Shared React components and hooks",
    "scripts": {
        "prepublishOnly": "yarn build",
        "graphql-generate": "graphql-codegen --config ./codegen.ts",
        "dev": "tsc --build  tsconfig.build.json --watch",
        "build": "tsc --build tsconfig.build.json && tsc-alias",
        "tscheck": "tsc --noEmit -p .",
        "tscheck:watch": "tsc -w --noEmit -p .",
        "test": "jest",
        "test:ci": "jest --maxWorkers=2",
        "test:commit": "jest --maxWorkers=50% --onlyChanged",
        "publish-ui": "yarn npm publish --access public",
        "get-version": "jq -r '.version' package.json",
        "set-version": "jq --arg v $1 '.version = $v' package.json > package.tmp.json && mv package.tmp.json package.json"
    },
    "main": "dist/index",
    "files": [
        "dist"
    ],
    "author": "",
    "license": "LGPL3",
    "repository": "https://github.com/leav-solutions/leav-engine",
    "devDependencies": {
        "@apollo/client": "3.8.1",
        "@babel/preset-env": "7.28.5",
        "@babel/preset-react": "7.28.5",
        "@graphql-codegen/add": "5.0.3",
        "@graphql-codegen/cli": "5.0.7",
        "@testing-library/jest-dom": "5.16.5",
        "@testing-library/react": "14.0.0",
        "@testing-library/react-hooks": "8.0.1",
        "@testing-library/user-event": "14.4.3",
        "@total-typescript/ts-reset": "0.6.1",
        "@types/dompurify": "3.0.3",
        "@types/jest": "29.0.2",
        "@types/lodash.isequal": "^4",
        "@types/object-path": "0.11.4",
        "@types/react": "18.2.14",
        "@types/react-beautiful-dnd": "13.1.8",
        "@types/react-dom": "18.2.6",
        "@types/react-table": "7.7.20",
        "antd": "5.22.2",
        "aristid-ds": "14.0.0-c13d6a5",
        "babel-jest": "29.3.1",
        "graphql": "16.12.0",
        "i18next": "22.5.1",
        "jest": "29.0.3",
        "jest-environment-jsdom": "29.3.1",
        "jest-styled-components": "7.2.0",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-i18next": "12",
        "react-router-dom": "6.22.0",
        "styled-components": "6.0.8",
        "ts-jest": "29.4.6",
        "tsc-alias": "1.8.16",
        "typescript": "5.5.3",
        "vite": "7.2.6"
    },
    "peerDependencies": {
        "@ant-design/icons": ">=5.2",
        "@apollo/client": ">=3.8.1",
        "antd": "5.22.2",
        "aristid-ds": "14.0.0-c13d6a5",
        "dayjs": "^1.11.13",
        "i18next": "22.5",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-i18next": "12",
        "react-icons": ">=4",
        "react-router-dom": "6.22.0",
        "styled-components": ">=5.3"
    },
    "dependencies": {
        "@ckeditor/ckeditor5-build-inline": "39.0.2",
        "@ckeditor/ckeditor5-react": "6.1.0",
        "@dnd-kit/core": "6.1.0",
        "@dnd-kit/sortable": "8.0.0",
        "@leav/utils": "workspace:libs/utils",
        "@uidotdev/usehooks": "2.4.1",
        "dompurify": "3.2.4",
