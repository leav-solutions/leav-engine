{
    "name": "@leav/ui",
    "version": "1.14.0",
    "description": "Shared React components and hooks",
    "scripts": {
        "prepublishOnly": "yarn build",
        "graphql-generate": "graphql-codegen --config ./codegen.ts",
        "dev": "tsc --build  tsconfig.build.json --watch",
        "build": "tsc --build tsconfig.build.json && tsc-alias",
        "clean": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
        "tscheck": "tsc --noEmit -p .",
        "tscheck:watch": "tsc -w --noEmit -p .",
        "test": "jest",
        "test:ci": "jest --maxWorkers=2",
        "test:commit": "jest --maxWorkers=50% --onlyChanged",
        "publish-ui": "yarn npm publish --access public",
        "get-version": "jq -r '.version' package.json",
        "set-version": "jq --arg v $1 '.version = $v' package.json > package.tmp.json && mv package.tmp.json package.json"
    },
    "main": "dist/index",
    "files": [
        "dist"
    ],
    "author": "",
    "license": "LGPL3",
    "repository": "https://github.com/leav-solutions/leav-engine",
    "devDependencies": {
        "@apollo/client": "3.14.1",
        "@babel/preset-env": "7.29.5",
        "@babel/preset-react": "7.28.5",
        "@graphql-codegen/add": "5.0.3",
        "@graphql-codegen/cli": "6.3.1",
        "@graphql-codegen/typescript": "5.0.10",
        "@graphql-codegen/typescript-operations": "5.1.0",
        "@graphql-codegen/typescript-react-apollo": "4.4.2",
        "@testing-library/jest-dom": "5.17.0",
        "@testing-library/react": "14.3.1",
        "@testing-library/react-hooks": "8.0.1",
        "@testing-library/user-event": "14.6.1",
        "@total-typescript/ts-reset": "0.6.1",
        "@types/jest": "29.5.14",
        "@types/react": "18.2.14",
        "@types/react-dom": "18.2.6",
        "aristid-ds": "15.3.1-77762e7",
        "babel-jest": "29.7.0",
        "graphql": "16.14.0",
        "i18next": "22.5.1",
        "jest": "29.7.0",
        "jest-environment-jsdom": "29.7.0",
        "jest-styled-components": "7.4.0",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-i18next": "12",
        "react-router-dom": "6.22.0",
        "ts-jest": "29.4.11",
        "tsc-alias": "1.8.17",
        "typescript": "5.9.3",
        "vite": "7.3.3"
    },
    "peerDependencies": {
        "@apollo/client": ">=3.8.1",
        "aristid-ds": "15.3.1-77762e7",
        "i18next": ">=22.5.1",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-i18next": ">=12",
        "react-router-dom": "^6.22.0"
    },
    "dependencies": {
        "@ant-design/icons": "5.6.1",
        "@dnd-kit/core": "6.3.1",
        "@dnd-kit/sortable": "8.0.0",
        "@dnd-kit/utilities": "3.2.2",
        "@leav/utils": "workspace:libs/utils",
        "@uidotdev/usehooks": "2.4.1",
        "dayjs": "^1.11.13",
        "dompurify": "3.4.5",
        "html-react-parser": "4.2.10",
        "i18next-resources-to-backend": "1.2.1",
        "react-markdown": "5.0.3",
        "styled-components": "6.0.8",
        "xlsx": "0.18.5",
        "zod": "3.25.76"
    }
}
