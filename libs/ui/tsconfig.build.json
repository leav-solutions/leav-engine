{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "./src",
        "composite": true,
        "inlineSources": true,
        "module": "esnext",
        "skipLibCheck": true,
        "jsx": "react-jsx",
        "resolveJsonModule": true,
        "paths": {
            "_ui/*": ["./src/*"]
        }
    },
    "include": ["src", "src/**/*.json"],
    "exclude": ["**/*.test.*", "**/_tests"]
}
