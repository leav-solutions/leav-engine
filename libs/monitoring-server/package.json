{
    "name": "@leav/monitoring-server",
    "version": "1.9.0-3",
    "description": "Module to create simple http monitoring server for health, metrics ...",
    "scripts": {
        "test": "jest -c jest-config.json",
        "test:ci": "jest -c jest-config.json --maxWorkers=2",
        "test:commit": "jest -c jest-config.json --maxWorkers=50% --onlyChanged ",
        "prepublishOnly": "npm run build",
        "build": "tsc --build tsconfig.build.json",
        "tscheck": "tsc --noEmit -p .",
        "tscheck:watch": "tsc -w --noEmit -p ."
    },
    "main": "dist/index",
    "keywords": [
        "monitoring",
        "healthcheck",
        "prometheus"
    ],
    "author": "",
    "license": "LGPL3",
    "stableVersion": "1.0.0",
    "dependencies": {
        "@hono/node-server": "1.19.9",
        "@leav/logger": "workspace:libs/logger",
        "hono": "4.10.7",
        "prom-client": "15.1.3"
    },
    "devDependencies": {
        "@types/jest": "29.5.14",
        "jest": "29.7.0",
        "node-fetch": "2.6.7",
        "ts-jest": "29.4.6",
        "typescript": "5.9.3"
    }
}
