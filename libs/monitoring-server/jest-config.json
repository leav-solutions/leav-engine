{
    "moduleFileExtensions": ["ts", "js"],
    "transform": {
        "\\.(ts|tsx)$": [
            "ts-jest",
            {
                "isolatedModules": true
            }
        ]
    },
    "moduleNameMapper": {
        "^@leav/(.*)$": "<rootDir>/../$1/src"
    },
    "testRegex": ".spec.ts$"
}
