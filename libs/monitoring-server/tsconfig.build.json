{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "types": ["node"],
        "outDir": "dist",
        "rootDir": "src",
        "composite": true,
        "isolatedModules": false,
        "strictNullChecks": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true
    },
    "references": [
        {
            "path": "../logger/tsconfig.build.json"
        }
    ],
    "include": ["./src"],
    "exclude": ["**/*.spec.ts"]
}
