{
    "name": "@leav/message-broker",
    "version": "1.13.0",
    "description": "Shared message broker to use across projects",
    "scripts": {
        "prepublishOnly": "npm run build",
        "build": "tsc --build tsconfig.build.json",
        "tscheck": "tsc --noEmit -p .",
        "tscheck:watch": "tsc -w --noEmit -p .",
        "test": "vitest run -c vitest.config.ts",
        "test:ci": "vitest run -c vitest.config.ts --maxWorkers=2 --reporter=verbose",
        "test:commit": "vitest run -c vitest.config.ts --changed"
    },
    "main": "dist/index",
    "keywords": [
        "config",
        "configuration",
        "settings"
    ],
    "author": "",
    "license": "LGPL3",
    "devDependencies": {
        "@types/amqplib": "0.10.8",
        "typescript": "5.9.3",
        "vitest": "4.1.5"
    },
    "dependencies": {
        "@leav/logger": "workspace:libs/logger",
        "amqplib": "0.10.9"
    },
    "stableVersion": "1.0.0"
}
