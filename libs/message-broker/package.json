{
    "name": "@leav/message-broker",
    "version": "1.6.0",
    "description": "Shared message broker to use across projects",
    "scripts": {
        "prepublishOnly": "npm run build",
        "build": "tsc --build tsconfig.build.json",
        "tscheck": "tsc --noEmit -p .",
        "tscheck:watch": "tsc -w --noEmit -p .",
        "test": "jest -c jest-config.json",
        "test:ci": "jest -c jest-config.json --maxWorkers=2",
        "test:commit": "jest -c jest-config.json --maxWorkers=50% --onlyChanged "
    },
    "main": "dist/index",
    "keywords": [
        "config",
        "configuration",
        "settings"
    ],
    "author": "",
    "license": "LGPL3",
    "devDependencies": {
        "@types/amqplib": "0.10.8",
        "@types/jest": "29.5.14",
        "jest": "29.7.0",
        "ts-jest": "29.4.6",
        "typescript": "5.5.3"
    },
    "dependencies": {
        "@leav/logger": "workspace:libs/logger",
        "amqplib": "0.10.9"
    },
    "stableVersion": "1.0.0"
}
