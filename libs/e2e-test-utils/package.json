{
    "name": "@leav/e2e-test-utils",
    "version": "1.19.1",
    "description": "Basic utilities for e2e tests, setup data",
    "main": "./src/index",
    "publishConfig": {
        "main": "./dist/index"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "graphql-generate": "graphql-codegen --config ./codegen.ts",
        "build": "tsc --build tsconfig.build.json",
        "clean": "rm -rf dist dist-spec tsconfig.build.tsbuildinfo",
        "tscheck": "tsc -b tsconfig.build.json",
        "tscheck:watch": "tsc -b -w tsconfig.json",
        "publish": "yarn npm publish --access public",
        "get-version": "jq -r '.version' package.json",
        "set-version": "jq --arg v $1 '.version = $v' package.json > package.tmp.json && mv package.tmp.json package.json"
    },
    "dependencies": {
        "@graphql-typed-document-node/core": "3.2.0",
        "graphql": "16.14.2",
        "graphql-request": "7.4.0",
        "graphql-tag": "2.12.7"
    },
    "devDependencies": {
        "@graphql-codegen/cli": "6.3.1",
        "@graphql-codegen/typescript": "5.0.10",
        "@graphql-codegen/typescript-graphql-request": "6.4.0",
        "@graphql-codegen/typescript-operations": "5.1.0",
        "@playwright/test": "1.62.1",
        "@types/node": "24.13.3",
        "typescript": "7.0.2"
    }
}
