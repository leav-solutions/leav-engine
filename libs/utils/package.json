{
    "name": "@leav/utils",
    "version": "1.18.0",
    "files": [
        "dist"
    ],
    "description": "LEAV Engine shared utils and types to use across projects",
    "main": "src/index",
    "publishConfig": {
        "main": "./dist/cjs/index",
        "module": "./dist/esm/index"
    },
    "scripts": {
        "prepublishOnly": "npm run build",
        "build": "tsc --project tsconfig.esm.json && tsc --project tsconfig.json",
        "clean": "rm -rf dist",
        "tscheck": "tsc --noEmit -p .",
        "tscheck:watch": "tsc -w --noEmit -p .",
        "test": "vitest run -c vitest.config.ts",
        "test:ci": "vitest run -c vitest.config.ts --maxWorkers=2 --reporter=verbose",
        "test:commit": "vitest run -c vitest.config.ts --changed",
        "publish": "yarn npm publish --access public",
        "get-version": "jq -r '.version' package.json",
        "set-version": "jq --arg v $1 '.version = $v' package.json > package.tmp.json && mv package.tmp.json package.json"
    },
    "repository": "https://github.com/leav-solutions/leav-engine",
    "author": "",
    "license": "LGPL3",
    "devDependencies": {
        "typescript": "6.0.3",
        "vitest": "4.1.10"
    },
    "dependencies": {
        "lodash": "4.18.1",
        "minimatch": "10.2.5"
    },
    "exports": {
        "import": "./dist/esm/index.js",
        "require": "./dist/cjs/index.js",
        "default": "./dist/cjs/index.js"
    }
}
