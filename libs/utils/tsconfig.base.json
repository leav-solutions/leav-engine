{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "module": "CommonJS",
        "moduleResolution": "node10",
        "ignoreDeprecations": "6.0",
        "composite": true,
        "rootDir": "./src",
        "strictNullChecks": true,
        "noImplicitReturns": true,
        "noUnusedLocals": true
    },
    "include": ["./src", "./src/**/*.json"],
    "exclude": ["**/__tests__", "**/*.test.*"]
}
