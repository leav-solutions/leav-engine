{
    "name": "app-studio",
    "description": "Generic application to create a workflow from a configuration",
    "version": "1.18.0",
    "private": true,
    "stableVersion": "0.1.0",
    "scripts": {
        "start": "vite",
        "build": "vite build",
        "build:install": "yarn run build --outDir ../core/applications/app-studio --emptyOutDir",
        "build:watch": "yarn run build:install --watch",
        "link:install": "ln -s ../../app-studio/dist ../core/applications/app-studio",
        "clean": "rm -rf dist tsconfig.build.tsbuildinfo tsconfig.spec.tsbuildinfo",
        "test": "vitest run -c vitest.config.ts",
        "test:ci": "vitest run -c vitest.config.ts --maxWorkers=2 --reporter=verbose",
        "graphql-generate": "graphql-codegen --config ./src/config/graphQL/codegen.ts",
        "tscheck": "tsc -b tsconfig.json"
    },
    "dependencies": {
        "@apollo/client": "3.14.1",
        "@bugsnag/js": "8.10.0",
        "@bugsnag/plugin-react": "8.9.0",
        "@dnd-kit/core": "6.3.1",
        "@dnd-kit/modifiers": "9.0.0",
        "@dnd-kit/sortable": "8.0.0",
        "@dnd-kit/utilities": "3.2.2",
        "@leav/ui": "workspace:libs/ui",
        "@leav/utils": "workspace:libs/utils",
        "aristid-ds": "17.0.0-247cdcd",
        "classnames": "2.5.1",
        "dayjs": "1.11.21",
        "graphql": "16.14.2",
        "graphql-ws": "5.16.2",
        "i18next": "22.5.1",
        "i18next-browser-languagedetector": "7.2.2",
        "i18next-resources-to-backend": "1.2.1",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-flag-kit": "1.1.1",
        "react-i18next": "12",
        "react-router-dom": "6.30.4",
        "zod": "3.25.76"
    },
    "resolutions": {
        "@types/react": "18.3.31",
        "@types/react-dom": "18.3.7"
    },
    "devDependencies": {
        "@graphql-codegen/cli": "6.3.1",
        "@graphql-codegen/client-preset": "4.8.3",
        "@graphql-codegen/typescript": "5.0.10",
        "@graphql-codegen/typescript-operations": "5.1.0",
        "@graphql-codegen/typescript-react-apollo": "4.4.2",
        "@graphql-typed-document-node/core": "3.2.0",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.1",
        "@total-typescript/ts-reset": "0.6.1",
        "@types/node": "24.13.3",
        "@types/react": "18.3.31",
        "@types/react-dom": "18.3.7",
        "@types/styled-components": "5.1.36",
        "@vitejs/plugin-react": "5.2.0",
        "browserslist": "4.28.6",
        "happy-dom": "20.11.0",
        "lightningcss": "1.32.0",
        "styled-components": "6.0.8",
        "typescript": "7.0.2",
        "vite": "7.3.6",
        "vite-plugin-dynamic-base": "1.4.1",
        "vite-plugin-svgr": "4.5.0",
        "vitest": "4.1.10"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
