{
    "name": "login",
    "description": "Application to login to LEAV when OIDC is not set.",
    "version": "1.12.0",
    "private": true,
    "stableVersion": "0.1.0",
    "scripts": {
        "start": "vite",
        "build": "vite build",
        "build:install": "yarn run build --outDir ../core/applications/login --emptyOutDir",
        "build:watch": "yarn run build:install --watch",
        "test": "jest",
        "test:ci": "jest --maxWorkers=2",
        "test:commit": "jest --maxWorkers=50% --onlyChanged ",
        "tscheck": "tsc --noEmit -p .",
        "tscheck:watch": "tsc -w --noEmit -p ."
    },
    "dependencies": {
        "@ant-design/icons": "5.6.1",
        "@apollo/client": "3.14.1",
        "@leav/ui": "workspace:libs/ui",
        "aristid-ds": "15.3.1-05878d4",
        "graphql": "16.13.2",
        "i18next": "22.5.1",
        "i18next-browser-languagedetector": "7.2.2",
        "i18next-resources-to-backend": "1.1.4",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-i18next": "12",
        "react-router-dom": "6.22.0",
        "styled-components": "6.0.8",
        "web-vitals": "2.1.4"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "5.17.0",
        "@testing-library/react": "14.3.1",
        "@testing-library/user-event": "13.5.0",
        "@total-typescript/ts-reset": "0.6.1",
        "@types/jest": "27.5.2",
        "@types/node": "24.12.2",
        "@types/react": "18.2.14",
        "@types/react-dom": "18.2.6",
        "@vitejs/plugin-react": "5.2.0",
        "babel-jest": "29.7.0",
        "jest": "29.7.0",
        "jest-environment-jsdom": "29.7.0",
        "jest-fetch-mock": "3.0.3",
        "ts-jest": "29.4.9",
        "ts-jest-mock-import-meta": "1.3.2",
        "typescript": "5.9.3",
        "vite": "7.3.2",
        "vite-plugin-dynamic-base": "1.3.0",
        "vite-plugin-rewrite-all": "1.0.2"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
