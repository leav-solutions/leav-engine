{
    "extends": "./tsconfig.build.json",
    "compilerOptions": {
        "outDir": "dist-spec",
        "tsBuildInfoFile": "dist-spec/tsconfig.spec.tsbuildinfo",
        "composite": true,
        "types": ["vitest/globals", "vitest/node", "node"]
    },
    "references": [{"path": "./tsconfig.build.json"}],
    "include": ["src/**/*.spec.ts", "src/**/__tests__/**/*"],
    "exclude": ["src/plugins"]
}
