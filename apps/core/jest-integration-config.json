{
    "moduleFileExtensions": ["ts", "js"],
    "transform": {
        "\\.(ts|tsx)$": [
            "ts-jest",
            {
                "isolatedModules": true
            }
        ]
    },
    "testRegex": "src/__tests__/integration/.*(.test.ts)$",
    "globalSetup": "./src/__tests__/integration/globalSetupHook.ts",
    "globalTeardown": "./src/__tests__/integration/teardown.ts",
    "setupFiles": ["<rootDir>/src/__tests__/setup.ts", "<rootDir>/src/__tests__/jestUtils.ts"],
    "testTimeout": 30000,
    "moduleNameMapper": {
        "^@leav/(.*)$": "<rootDir>/../../libs/$1/src"
    }
}
