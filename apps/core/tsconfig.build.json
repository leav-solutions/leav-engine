{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "types": ["node"],
        "baseUrl": "src",
        "rootDir": "src",
        "outDir": "dist",
        "isolatedModules": false,
        "declarationMap": false,
        "declaration": false,
        "sourceMap": false,
        "composite": false,
        "resolveJsonModule": true,
        "noImplicitReturns": true
    },
    "references": [
        {
            "path": "../../libs/app-root-path"
        },
        {
            "path": "../../libs/config-manager"
        },
        {
            "path": "../../libs/utils"
        },
        {
            "path": "../../libs/message-broker"
        },
        {
            "path": "../../libs/monitoring-server"
        }
    ],
    "include": ["src/**/*", "src/**/*.json"],
    "exclude": [
        "node_modules",
        "**/*.spec.ts",
        "**/__tests__",
        "applications",
        "scripts",
        "dist"
    ]
}
