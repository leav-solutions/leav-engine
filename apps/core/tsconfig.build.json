{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "types": ["node"],
        "rootDir": "src",
        "outDir": "dist",
        "isolatedModules": false,
        "sourceMap": true,
        "composite": true,
        "tsBuildInfoFile": "dist/tsconfig.build.tsbuildinfo",
        "resolveJsonModule": true,
        "noImplicitReturns": true,
        "typeRoots": [
            "./src/_types",
            "./node_modules/@types",
            "./node_modules",
            "../../node_modules/@types",
            "../../node_modules"
        ],
        "paths": {
            "@leav/core/*": ["./src/*"],
            "@leav/*": ["../../libs/*/src"]
        }
    },
    "references": [
        {
            "path": "../../libs/app-root-path/tsconfig.build.json"
        },
        {
            "path": "../../libs/config-manager/tsconfig.build.json"
        },
        {
            "path": "../../libs/logger/tsconfig.build.json"
        },
        {
            "path": "../../libs/utils/tsconfig.json"
        },
        {
            "path": "../../libs/message-broker/tsconfig.build.json"
        },
        {
            "path": "../../libs/monitoring-server/tsconfig.build.json"
        }
    ],
    "include": ["src/**/*", "src/**/*.json"],
    "exclude": ["node_modules", "**/*.spec.ts", "**/__tests__", "applications", "scripts", "dist"]
}
