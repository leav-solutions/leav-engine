{
    "name": "core",
    "version": "1.12.0",
    "description": "",
    "scripts": {
        "start": "node .",
        "start:watch": "npm run start:dev",
        "start:files": "CORE_MODE=filesManager tsx watch --clear-screen=false --ignore src/__tests__ --ignore 'src/**/*.spec.ts' --inspect=0.0.0.0:9230 ./src",
        "start:indexation": "CORE_MODE=indexationManager tsx watch --clear-screen=false --ignore src/__tests__ --ignore 'src/**/*.spec.ts' src/",
        "start:tasksMaster": "CORE_MODE=tasksManager:master tsx watch --clear-screen=false --ignore src/__tests__ --ignore 'src/**/*.spec.ts' --inspect=0.0.0.0:9232 src/",
        "start:tasksWorker": "CORE_MODE=tasksManager:worker tsx watch --clear-screen=false --ignore src/__tests__ --ignore 'src/**/*.spec.ts' --inspect=0.0.0.0:9234 src/",
        "start:logsCollector": "CORE_MODE=logsCollector tsx watch --clear-screen=false --ignore src/__tests__ --ignore 'src/**/*.spec.ts' --inspect=0.0.0.0:9235 src/",
        "start:dev": "CORE_MODE=server tsx watch --clear-screen=false --ignore src/__tests__ --ignore 'src/**/*.spec.ts' --inspect=0.0.0.0:9229 ./src",
        "test:watch": "vitest -c vitest.unit.config.ts",
        "test": "vitest run -c vitest.unit.config.ts",
        "test:ci": "vitest run -c vitest.unit.config.ts --maxWorkers=2 --reporter=verbose",
        "test:commit": "vitest run -c vitest.unit.config.ts --changed",
        "test:e2e": "npm run test:e2e:api",
        "test:integration": "CONFIG_IGNORE_LOCAL=true NODE_ENV=test NODE_OPTIONS='--import tsx' vitest run -c vitest.integration.config.ts",
        "test:e2e:api": "CONFIG_IGNORE_LOCAL=true NODE_ENV=test NODE_OPTIONS='--import tsx' vitest run -c vitest.e2e-api.config.ts",
        "test:e2e:filesManager": "CONFIG_IGNORE_LOCAL=true NODE_ENV=test NODE_OPTIONS='--import tsx'  vitest run -c vitest.e2e-filesManager.config.ts",
        "test:e2e:indexationManager": "CONFIG_IGNORE_LOCAL=true NODE_ENV=test NODE_OPTIONS='--import tsx' vitest run -c vitest.e2e-indexationManager.config.ts",
        "prettier": "prettier --write 'src/**/*.ts'",
        "db:migrate": "CORE_MODE=migrate node .",
        "db:migrate:dev": "CORE_MODE=migrate tsx src/",
        "importConfig": "CORE_MODE=cli tsx src/ importConfig --clear",
        "importData": "CORE_MODE=cli tsx src/ importData",
        "graphql-generate": "graphql-codegen --config ./codegen.ts",
        "buildapps": "node . build-apps",
        "buildapps:dev": "tsx src/ build-apps",
        "benchmark": "tsx src/ benchmark",
        "build": "scripts/build.js",
        "build-types": "tsc -b tsconfig.types.json",
        "tscheck": "tsc --noEmit -p .",
        "tscheck:watch": "tsc -w --noEmit -p tsconfig.json"
    },
    "main": "dist/index.js",
    "author": "",
    "license": "LGPL3",
    "devDependencies": {
        "@graphql-codegen/add": "5.0.3",
        "@graphql-codegen/cli": "6.3.1",
        "@graphql-codegen/client-preset": "4.8.3",
        "@graphql-codegen/typescript": "5.0.10",
        "@graphql-codegen/typescript-graphql-request": "6.4.0",
        "@graphql-codegen/typescript-operations": "5.1.0",
        "@trpc/client": "11.16.0",
        "@types/amqplib": "0.10.8",
        "@types/cacache": "15.0.1",
        "@types/compression": "1.8.1",
        "@types/debug": "0.0.31",
        "@types/graphql-upload": "16.0.7",
        "@types/jest-when": "3.5.5",
        "@types/jexl": "2.3.4",
        "@types/jsonwebtoken": "9.0.10",
        "@types/lodash": "4.17.24",
        "@types/ms": "0.7.34",
        "@types/node": "24.12.2",
        "@types/nodemailer": "6.4.23",
        "@types/ws": "8.5.3",
        "axios": "1.15.1",
        "eventsource": "4.1.0",
        "graphql-request": "7.4.0",
        "jest-when": "3.7.0",
        "prettier": "3.3.3",
        "tsx": "4.21.0",
        "typescript": "5.9.3",
        "vitest": "4.1.4"
    },
    "dependencies": {
        "@apollo/server": "4.13.0",
        "@bugsnag/js": "8.9.0",
        "@elastic/elasticsearch": "8.19.1",
        "@graphql-tools/schema": "10.0.32",
        "@leav/app-root-path": "workspace:libs/app-root-path",
        "@leav/config-manager": "workspace:libs/config-manager",
        "@leav/logger": "workspace:libs/logger",
        "@leav/message-broker": "workspace:libs/message-broker",
        "@leav/monitoring-server": "workspace:libs/monitoring-server",
        "@leav/utils": "workspace:*",
        "@trpc/server": "11.16.0",
        "add-filename-increment": "1.0.0",
        "amqplib": "0.10.9",
        "app-root-path": "3.1.0",
        "arangojs": "8.8.1",
        "awilix": "12.1.1",
        "bcryptjs": "2.4.3",
        "body-parser": "1.20.4",
        "cacache": "15.3.0",
        "commander": "14.0.3",
        "compression": "1.8.1",
        "cookie-parser": "1.4.7",
        "cors": "2.8.6",
        "dataloader": "2.2.3",
        "dayjs": "1.11.20",
        "exceljs": "4.4.0",
        "exiftool-vendored": "29.3.0",
        "express": "4.22.1",
        "express-useragent": "1.0.15",
        "graphql": "16.13.2",
        "graphql-subscriptions": "2.0.0",
        "graphql-type-json": "0.3.2",
        "graphql-upload": "16.0.2",
        "graphql-ws": "5.16.2",
        "handlebars": "4.7.9",
        "hyperformula": "3.2.0",
        "i18next": "22.5.1",
        "i18next-fs-backend": "2.6.4",
        "jexl-extended": "1.4.2",
        "joi": "18.0.2",
        "jsonparse": "1.3.1",
        "jsonschema": "1.4.1",
        "jsonwebtoken": "9.0.3",
        "lodash": "4.17.23",
        "ms": "2.1.3",
        "nanoid": "3.3.11",
        "node-cron": "4.2.1",
        "nodemailer": "7.0.13",
        "openid-client": "5.6.5",
        "progress-stream": "2.0.0",
        "redis": "5.10.0",
        "ws": "8.17.1",
        "zod": "4.3.6"
    },
    "stableVersion": "1.0.0-alpha2"
}
