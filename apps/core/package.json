{
    "name": "core",
    "version": "1.16.0",
    "description": "",
    "scripts": {
        "start": "node .",
        "start:watch": "npm run start:dev",
        "start:dev": "tsx watch --clear-screen=false --ignore src/__tests__ --ignore 'src/**/*.spec.ts' --inspect=0.0.0.0:9229 ./src",
        "test:watch": "vitest -c vitest.unit.config.ts",
        "test": "vitest run -c vitest.unit.config.ts",
        "test:ci": "vitest run -c vitest.unit.config.ts --maxWorkers=2 --reporter=verbose",
        "test:commit": "vitest run -c vitest.unit.config.ts --changed",
        "test:e2e": "npm run test:e2e:api",
        "test:e2e:debug": "LOG_SILENT=0 LOG_LEVEL=silly npm run test:e2e",
        "test:integration": "CONFIG_IGNORE_LOCAL=true NODE_ENV=test NODE_OPTIONS='--import tsx' vitest run -c vitest.integration.config.ts",
        "test:integration:debug": "LOG_SILENT=0 LOG_LEVEL=silly npm run test:integration",
        "test:e2e:api": "CONFIG_IGNORE_LOCAL=true NODE_ENV=test NODE_OPTIONS='--import tsx' vitest run -c vitest.e2e-api.config.ts",
        "test:e2e:filesManager": "CONFIG_IGNORE_LOCAL=true NODE_ENV=test NODE_OPTIONS='--import tsx'  vitest run -c vitest.e2e-filesManager.config.ts",
        "test:e2e:indexationManager": "CONFIG_IGNORE_LOCAL=true NODE_ENV=test NODE_OPTIONS='--import tsx' vitest run -c vitest.e2e-indexationManager.config.ts",
        "prettier": "prettier --write 'src/**/*.ts'",
        "db:migrate": "CORE_MODE=cli node . dbMigrate",
        "db:migrate:dev": "CORE_MODE=cli tsx src/ dbMigrate",
        "importConfig": "CORE_MODE=cli tsx src/ importConfig --clear",
        "importData": "CORE_MODE=cli tsx src/ importData",
        "graphql-generate": "graphql-codegen --config ./codegen.ts",
        "buildapps": "node . build-apps",
        "buildapps:dev": "tsx src/ build-apps",
        "benchmark": "tsx src/ benchmark",
        "build": "scripts/build.js",
        "clean": "rm -rf dist dist-spec dist-types tsconfig.build.tsbuildinfo tsconfig.spec.tsbuildinfo",
        "build-types": "tsc -b tsconfig.types.json",
        "tscheck": "tsc -b tsconfig.build.json && tsc --noEmit -p tsconfig.spec.json",
        "tscheck:watch": "tsc -b -w tsconfig.json"
    },
    "main": "dist/index.js",
    "author": "",
    "license": "LGPL3",
    "devDependencies": {
        "@graphql-codegen/add": "5.0.3",
        "@graphql-codegen/cli": "6.3.1",
        "@graphql-codegen/client-preset": "4.8.3",
        "@graphql-codegen/typescript": "5.0.10",
        "@graphql-codegen/typescript-graphql-request": "6.4.0",
        "@graphql-codegen/typescript-operations": "5.1.0",
        "@trpc/client": "11.16.0",
        "@types/cacache": "20.0.1",
        "@types/compression": "1.8.1",
        "@types/debug": "0.0.31",
        "@types/graphql-upload": "16.0.7",
        "@types/jest-when": "3.5.5",
        "@types/jexl": "2.3.4",
        "@types/jsonwebtoken": "9.0.10",
        "@types/lodash": "4.17.24",
        "@types/ms": "0.7.34",
        "@types/node": "24.13.2",
        "@types/nodemailer": "6.4.24",
        "@types/ws": "8.18.1",
        "axios": "1.18.0",
        "eventsource": "4.1.0",
        "graphql-request": "7.4.0",
