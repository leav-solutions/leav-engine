{
    "name": "core",
    "version": "1.6.0",
    "description": "",
    "scripts": {
        "start": "node .",
        "start:watch": "npm run start:dev",
        "start:files": "CORE_MODE=filesManager tsx watch --clear-screen=false --inspect=0.0.0.0:9230 ./src",
        "start:indexation": "CORE_MODE=indexationManager tsx watch --clear-screen=false src/",
        "start:tasksMaster": "CORE_MODE=tasksManager:master tsx watch --clear-screen=false --inspect=0.0.0.0:9232 src/",
        "start:tasksWorker": "CORE_MODE=tasksManager:worker tsx watch --clear-screen=false --inspect=0.0.0.0:9234 src/",
        "start:logsCollector": "CORE_MODE=logsCollector tsx watch --clear-screen=false --inspect=0.0.0.0:9235 src/",
        "start:dev": "CORE_MODE=server tsx watch --clear-screen=false --inspect=0.0.0.0:9229 ./src",
        "test:watch": "jest -c jest-unit-config.json --watch",
        "test": "jest -c jest-unit-config.json",
        "test:ci": "jest -c jest-unit-config.json --maxWorkers=2",
        "test:commit": "jest -c jest-unit-config.json --maxWorkers=50% --onlyChanged ",
        "test:e2e": "npm run test:e2e:api",
        "test:integration": "CONFIG_IGNORE_LOCAL=true NODE_ENV=test NODE_OPTIONS='--import tsx' jest -c jest-integration-config.json --maxWorkers=2 --forceExit --detectOpenHandles",
        "test:e2e:api": "CONFIG_IGNORE_LOCAL=true NODE_ENV=test NODE_OPTIONS='--import tsx' jest -c jest-e2e-api-config.json --maxWorkers=2 --forceExit --detectOpenHandles",
        "test:e2e:filesManager": "CONFIG_IGNORE_LOCAL=true NODE_ENV=test NODE_OPTIONS='--import tsx' jest -c jest-e2e-filesManager-config.json --forceExit --detectOpenHandles",
        "test:e2e:indexationManager": "CONFIG_IGNORE_LOCAL=true NODE_ENV=test NODE_OPTIONS='--import tsx' jest -c jest-e2e-indexationManager-config.json --forceExit --detectOpenHandles",
        "prettier": "prettier --write 'src/**/*.ts'",
        "db:migrate": "CORE_MODE=migrate node .",
        "db:migrate:dev": "CORE_MODE=migrate tsx src/",
        "importConfig": "CORE_MODE=cli tsx src/ importConfig --clear",
        "importData": "CORE_MODE=cli tsx src/ importData",
        "buildapps": "node . build-apps",
        "buildapps:dev": "tsx src/ build-apps",
        "benchmark": "tsx src/ benchmark",
        "build": "scripts/build.js",
        "build-types": "tsc -b tsconfig.types.json",
        "tscheck": "tsc --noEmit -p .",
        "tscheck:watch": "tsc -w --noEmit -p tsconfig.json"
    },
    "main": "dist/index.js",
    "author": "",
    "license": "LGPL3",
    "devDependencies": {
        "@types/amqplib": "0.10.8",
        "@types/cacache": "15.0.1",
        "@types/compression": "1.7.5",
        "@types/debug": "0.0.31",
        "@types/graphql-upload": "16.0.7",
        "@types/jest": "29.5.14",
        "@types/jest-when": "3.5.5",
        "@types/jsonwebtoken": "9.0.10",
        "@types/lodash": "4.17.21",
        "@types/ms": "0.7.34",
        "@types/node": "24.10.4",
        "@types/nodemailer": "6.4.21",
        "@types/ws": "8.5.3",
        "axios": "1.13.2",
        "jest": "29.7.0",
        "jest-when": "3.7.0",
        "prettier": "3.3.3",
        "ts-jest": "29.4.6",
        "tsx": "4.21.0",
        "typescript": "5.5.3"
    },
    "dependencies": {
        "@apollo/server": "4.11.0",
        "@bugsnag/js": "8.4.0",
        "@elastic/elasticsearch": "8.10.0",
        "@graphql-tools/schema": "10.0.30",
        "@leav/app-root-path": "workspace:libs/app-root-path",
        "@leav/config-manager": "workspace:libs/config-manager",
        "@leav/logger": "workspace:libs/logger",
        "@leav/message-broker": "workspace:libs/message-broker",
        "@leav/monitoring-server": "workspace:libs/monitoring-server",
        "@leav/utils": "workspace:*",
        "add-filename-increment": "1.0.0",
        "amqplib": "0.10.9",
        "app-root-path": "3.1.0",
        "arangojs": "8.1.0",
        "awilix": "12.0.5",
        "bcryptjs": "2.4.3",
        "body-parser": "1.20.4",
        "cacache": "15.3.0",
        "commander": "14.0.2",
        "compression": "1.7.4",
        "cookie-parser": "1.4.7",
        "cors": "2.8.5",
        "dataloader": "2.2.3",
        "dayjs": "1.11.13",
        "exceljs": "4.2.0",
        "exiftool-vendored": "29.1.0",
        "express": "4.20.0",
        "express-useragent": "1.0.15",
        "graphql": "16.12.0",
        "graphql-subscriptions": "2.0.0",
        "graphql-type-json": "0.3.2",
        "graphql-upload": "16.0.2",
        "graphql-ws": "5.10.0",
        "handlebars": "4.7.8",
        "hot-formula-parser": "4.0.0",
        "hyperformula": "3.1.1",
        "i18next": "22.5.1",
        "i18next-fs-backend": "2.1.2",
        "joi": "17.6.0",
        "jsonparse": "1.3.1",
        "jsonschema": "1.4.1",
        "jsonwebtoken": "9.0.3",
        "lodash": "4.17.21",
        "ms": "2.1.3",
        "nanoid": "3.3.11",
        "nodemailer": "7.0.12",
        "openid-client": "5.6.5",
        "progress-stream": "2.0.0",
        "redis": "5.10.0",
        "ws": "8.17.1"
    },
    "stableVersion": "1.0.0-alpha2"
}
