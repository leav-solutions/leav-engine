{
    "name": "core",
    "version": "1.4.1",
    "description": "",
    "scripts": {
        "start": "node .",
        "start:watch": "npm run start:dev",
        "start:files": "ts-node-dev --transpile-only --inspect=0.0.0.0:9230 --respawn src/ --filesManager",
        "start:indexation": "ts-node-dev --transpile-only --respawn src/ --indexationManager",
        "start:tasksMaster": "ts-node-dev --transpile-only --inspect=0.0.0.0:9232 --respawn src/ --tasksManager=master",
        "start:tasksWorker": "ts-node-dev --transpile-only --inspect=0.0.0.0:9234 --respawn src/ --tasksManager=worker",
        "start:dev": "ts-node-dev --transpile-only --inspect=0.0.0.0:9229 --respawn src/ --server",
        "test:watch": "jest -c jest-unit-config.json --watch",
        "test": "jest -c jest-unit-config.json",
        "test:ci": "jest -c jest-unit-config.json --maxWorkers=2",
        "test:commit": "jest -c jest-unit-config.json --maxWorkers=50% --onlyChanged ",
        "test:e2e": "npm run test:e2e:api",
        "test:integration": "CONFIG_IGNORE_LOCAL=true NODE_ENV=test jest -c jest-integration-config.json --maxWorkers=2 --forceExit --detectOpenHandles",
        "test:e2e:api": "CONFIG_IGNORE_LOCAL=true NODE_ENV=test jest -c jest-e2e-api-config.json --maxWorkers=2 --forceExit --detectOpenHandles",
        "test:e2e:filesManager": "CONFIG_IGNORE_LOCAL=true NODE_ENV=test jest -c jest-e2e-filesManager-config.json --forceExit --detectOpenHandles",
        "test:e2e:indexationManager": "CONFIG_IGNORE_LOCAL=true NODE_ENV=test jest -c jest-e2e-indexationManager-config.json --forceExit --detectOpenHandles",
        "lint": "eslint --fix src/",
        "prettier": "prettier --write 'src/**/*.ts'",
        "db:migrate": "CORE_MODE=migrate node .",
        "db:migrate:dev": "CORE_MODE=migrate ts-node --transpileOnly src/",
        "importConfig": "CORE_MODE=cli ts-node --transpileOnly src/ importConfig --clear",
        "importData": "CORE_MODE=cli ts-node --transpileOnly src/ importData",
        "buildapps": "node . build-apps",
        "buildapps:dev": "ts-node src/ build-apps",
        "benchmark": "ts-node src/ benchmark",
        "build": "scripts/build.js",
        "build-types": "tsc -b tsconfig.types.json",
        "tscheck": "tsc --noEmit -p .",
        "tscheck:watch": "tsc -w --noEmit -p tsconfig.json"
    },
    "main": "dist/index.js",
    "author": "",
    "license": "LGPL3",
    "devDependencies": {
        "@types/amqplib": "0.10.7",
        "@types/cacache": "15.0.1",
        "@types/compression": "1.7.5",
        "@types/debug": "0.0.31",
        "@types/glob": "5.0.37",
        "@types/jest": "29.5.13",
        "@types/jest-when": "3.5.5",
        "@types/jsonwebtoken": "8.5.9",
        "@types/lodash": "4.14.185",
        "@types/ms": "0.7.31",
        "@types/node": "18.7.18",
        "@types/nodemailer": "6.4.6",
        "@types/uuid": "7.0.5",
        "@types/ws": "8.5.3",
        "axios": "1.8.2",
        "jest": "29.7.0",
        "jest-when": "3.6.0",
        "lint-staged": "7.3.0",
        "moment-timezone": "0.5.37",
        "nodemon": "1.19.4",
        "npm-run-all": "4.1.5",
        "prettier": "3.3.3",
        "ts-jest": "29.2.5",
        "ts-node": "10.9.1",
        "ts-node-dev": "2.0.0",
        "typescript": "5.5.3",
        "watch": "1.0.2"
    },
    "dependencies": {
        "@apollo/server": "4.11.0",
        "@bugsnag/js": "8.4.0",
        "@elastic/elasticsearch": "8.10.0",
        "@graphql-tools/schema": "10.0.0",
        "@leav/app-root-path": "workspace:libs/app-root-path",
        "@leav/config-manager": "workspace:libs/config-manager",
        "@leav/logger": "workspace:libs/logger",
        "@leav/message-broker": "workspace:libs/message-broker",
        "@leav/monitoring-server": "workspace:libs/monitoring-server",
        "@leav/utils": "workspace:*",
        "add-filename-increment": "1.0.0",
        "amqplib": "0.10.9",
        "app-root-path": "3.1.0",
        "arangojs": "8.1.0",
        "awilix": "3.0.9",
        "bcryptjs": "2.4.3",
        "body-parser": "1.20.3",
        "cacache": "15.3.0",
        "commander": "2.20.3",
        "compression": "1.7.4",
        "cookie-parser": "1.4.6",
        "cors": "2.8.5",
        "dataloader": "2.2.3",
        "exceljs": "4.2.0",
        "exiftool-vendored": "29.1.0",
        "express": "4.20.0",
        "express-useragent": "1.0.15",
        "glob": "7.1.6",
        "graphql": "16.6.0",
        "graphql-subscriptions": "2.0.0",
        "graphql-type-json": "0.3.2",
        "graphql-upload": "16.0.2",
        "graphql-ws": "5.10.0",
        "handlebars": "4.7.7",
        "hot-formula-parser": "4.0.0",
        "i18next": "22.5.0",
        "i18next-fs-backend": "2.1.2",
        "joi": "17.6.0",
        "jsonparse": "1.3.1",
        "jsonschema": "1.4.1",
        "jsonwebtoken": "9.0.0",
        "lodash": "4.17.21",
        "moment": "2.29.4",
        "ms": "2.1.3",
        "nanoid": "3.3.8",
        "nodemailer": "6.9.9",
        "openid-client": "5.6.5",
        "progress-stream": "2.0.0",
        "redis": "4.0.4",
        "uuid": "7.0.3",
        "ws": "8.17.1"
    },
    "stableVersion": "1.0.0-alpha2"
}
