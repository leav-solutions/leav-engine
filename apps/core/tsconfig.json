{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "types": ["vitest/globals", "vitest/node", "node"],
        "outDir": "dist",
        "isolatedModules": false,
        "typeRoots": [
            "./src/_types",
            "./node_modules/@types",
            "./node_modules",
            "../../node_modules/@types",
            "../../node_modules"
        ],
        "noImplicitReturns": true
        // "strictNullChecks": true
    },
    "exclude": ["applications"]
}
