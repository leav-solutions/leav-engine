{
    "name": "automate-scan",
    "version": "1.6.0",
    "description": "",
    "main": "dist/index.js",
    "scripts": {
        "start": "node .",
        "start:watch": "npm run start:dev",
        "start:dev": "tsx watch --clear-screen=false ./src ",
        "start:watch:test": "NODE_ENV=test tsx watch --clear-screen=false src/",
        "dev": "npm run start:watch",
        "build": "tsc -b tsconfig.build.json",
        "test": "jest -c jest-unit-config.json",
        "test:ci": "jest -c jest-unit-config.json --maxWorkers=2",
        "test:commit": "jest -c jest-unit-config.json --maxWorkers=50% --onlyChanged ",
        "test:watch": "jest -c jest-unit-config.json --watch",
        "test:integration": "NODE_ENV=test-integration NODE_OPTIONS='--import tsx' jest -c jest-integration-config.json",
        "prettier": "prettier --write 'src/**/*.ts'",
        "tscheck": "tsc --noEmit -p .",
        "tscheck:watch": "tsc -w --noEmit -p ."
    },
    "repository": {
        "type": "git",
        "url": ""
    },
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@types/amqplib": "0.10.8",
        "@types/jest": "24.9.1",
        "@types/node": "24.10.4",
        "jest": "29.0.3",
        "prettier": "3.3.3",
        "ts-jest": "29.4.6",
        "tsx": "4.20.5",
        "typescript": "5.5.3"
    },
    "dependencies": {
        "@leav/app-root-path": "workspace:libs/app-root-path",
        "@leav/config-manager": "workspace:libs/config-manager",
        "@leav/logger": "workspace:libs/logger",
        "@leav/monitoring-server": "workspace:libs/monitoring-server",
        "@leav/utils": "workspace:*",
        "amqplib": "0.10.9",
        "app-root-path": "3.1.0",
        "chokidar": "4.0.3",
        "lodash": "4.17.21",
        "redis": "5.10.0"
    },
    "stableVersion": "1.0.0"
}
