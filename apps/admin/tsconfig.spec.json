{
    "extends": "./tsconfig.build.json",
    "compilerOptions": {
        "outDir": "dist-spec",
        "composite": true,
        "types": ["vitest/globals", "node"]
    },
    "references": [{"path": "./tsconfig.build.json"}],
    "include": [
        "src/**/*.test.ts",
        "src/**/*.test.tsx",
        "src/__tests__/**/*",
        "src/_tests/**/*",
        "src/**/__mocks__/**/*",
        "src/**/_fixtures/**/*",
        "src/constants.ts",
        "src/_gqlTypes/customScalars.ts"
    ],
    "exclude": []
}
