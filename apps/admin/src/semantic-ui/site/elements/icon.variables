/*******************************
    User Variable Overrides
*******************************/

/* None of the 506 brand icons (facebook, github, docker, …) is used in the admin app. */
@variationIconBrand: false;

/* @variationIconBrand only skips the CSS rules: the @font-face itself is emitted by `each(@fonts)`
   under @importIcons (fomantic-ui-less/definitions/elements/icon.less). The map must therefore be
   redeclared without the brand entry so that brand-icons.woff2 stops being emitted too.
   Outline icons must stay: `edit outline`, `save outline`, `trash alternate outline` and
   `plus square outline` are used in the app. */
@fonts: {
    @regular: {
        font-family: @fontName;
        src: url("@{fontPath}/@{fontName}.woff2") format("woff2");
        font-style: normal;
        font-weight: @normal;
        font-display: block;
        font-variant: normal;
        text-decoration: inherit;
        text-transform: none;
    };
    @outline: {
        font-family: @outlineFontName;
        src: url("@{fontPath}/@{outlineFontName}.woff2") format("woff2");
        font-style: normal;
        font-weight: @normal;
        font-display: block;
        font-variant: normal;
        text-decoration: inherit;
        text-transform: none;
    };
};
