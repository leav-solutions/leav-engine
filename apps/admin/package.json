{
    "name": "admin",
    "description": "Administration",
    "version": "1.18.0",
    "private": true,
    "stableVersion": "0.1.0",
    "scripts": {
        "start": "vite",
        "build": "vite build",
        "build:install": "yarn run build --outDir ../core/applications/admin --emptyOutDir",
        "build:watch": "yarn run build:install --watch",
        "link:install": "ln -s ../../admin/dist ../core/applications/admin",
        "clean": "rm -rf dist tsconfig.build.tsbuildinfo tsconfig.spec.tsbuildinfo",
        "test": "vitest run -c vitest.config.ts",
        "test:ci": "vitest run -c vitest.config.ts --maxWorkers=2 --reporter=verbose",
        "test:commit": "vitest run -c vitest.config.ts --changed",
        "graphql-generate": "graphql-codegen --config ./codegen.ts",
        "create_comp": "scripts/createComponent.js",
        "tscheck": "tsc -b tsconfig.build.json && tsc --noEmit -p tsconfig.spec.json",
        "tscheck:watch": "tsc -b -w tsconfig.json",
        "postinstall": "node scripts/fixSemanticUiCss.js"
    },
    "dependencies": {
        "@apollo/client": "3.14.1",
        "@leav/ui": "workspace:libs/ui",
        "@leav/utils": "workspace:libs/utils",
        "@nosferatu500/react-sortable-tree": "4.4.0",
        "@reduxjs/toolkit": "1.9.7",
        "@rjsf/core": "6.7.0",
        "@rjsf/utils": "6.7.0",
        "@rjsf/validator-ajv8": "6.7.0",
        "@uiw/react-json-view": "2.0.0-alpha.43",
        "aristid-ds": "16.2.0-3ed127f",
        "cross-fetch": "3.2.0",
        "dayjs": "1.11.21",
        "fomantic-ui-less": "2.9.4",
        "formik": "1.5.8",
        "graphql": "16.14.2",
        "graphql-ws": "5.16.2",
        "hex-rgba": "1.0.2",
        "i18next": "22.5.1",
        "i18next-browser-languagedetector": "7.2.2",
        "i18next-xhr-backend": "3.2.2",
        "jsoneditor": "9.10.5",
        "jsoneditor-react": "3.1.2",
        "lodash": "4.18.1",
        "react": "18.2.0",
        "react-dnd": "14.0.5",
        "react-dnd-html5-backend": "14.1.0",
        "react-dom": "18.2.0",
        "react-i18next": "12",
        "react-markdown": "5.0.3",
        "react-redux": "7.2.9",
        "react-router-dom": "6.30.4",
        "semantic-ui-react": "2.1.5",
        "sleep-promise": "8.0.1",
        "styled-components": "6.0.8",
        "yup": "0.32.11"
    },
    "devDependencies": {
        "@graphql-codegen/cli": "6.3.1",
        "@graphql-codegen/typescript": "5.0.10",
        "@graphql-codegen/typescript-operations": "5.1.0",
        "@graphql-codegen/typescript-react-apollo": "4.4.2",
        "@semantic-ui-react/craco-less": "2.0.2",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.1",
        "@types/lodash": "4.17.24",
        "@types/node": "24.13.3",
        "@types/react": "18.2.14",
        "@types/react-dom": "18.2.14",
        "@types/react-test-renderer": "18.3.1",
        "@types/redux-mock-store": "1.5.0",
        "@types/styled-components": "4.4.3",
        "@vitejs/plugin-react": "5.2.0",
        "jest-styled-components": "7.4.0",
        "jsdom": "26.1.0",
        "react-dnd-test-backend": "16.0.1",
        "react-test-renderer": "18.2.0",
        "redux-mock-store": "1.5.5",
        "typescript": "6.0.3",
        "vite": "7.3.6",
        "vite-plugin-svgr": "4.5.0",
        "vitest": "4.1.10"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
