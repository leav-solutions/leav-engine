{
    "name": "preview-generator",
    "version": "1.5.2",
    "description": "",
    "main": "dist/index.js",
    "scripts": {
        "start": "node .",
        "start:watch": "tsx watch --clear-screen=false src/",
        "build": "tsc -b tsconfig.build.json",
        "test:watch": "jest -c jest-unit-config.json --watch",
        "test": "jest -c jest-unit-config.json",
        "test:ci": "jest -c jest-unit-config.json --maxWorkers=2",
        "test:commit": "jest -c jest-unit-config.json --maxWorkers=50% --onlyChanged ",
        "test:integration": "NODE_OPTIONS='--import tsx' jest -c jest-integration-config.json",
        "prettier": "prettier --write 'src/**/*.ts'",
        "tscheck": "tsc --noEmit -p .",
        "tscheck:watch": "tsc -w --noEmit -p ."
    },
    "author": "",
    "license": "LGPL3",
    "devDependencies": {
        "@types/amqplib": "0.10.7",
        "@types/jest": "29.0.2",
        "@types/node": "24.7.2",
        "jest": "29.0.3",
        "nodemon": "1.19.4",
        "onchange": "6.1.1",
        "prettier": "3.3.3",
        "ts-jest": "29.0.1",
        "tsx": "4.20.5",
        "typescript": "5.5.3"
    },
    "dependencies": {
        "@leav/app-root-path": "workspace:libs/app-root-path",
        "@leav/config-manager": "workspace:libs/config-manager",
        "@leav/monitoring-server": "workspace:libs/monitoring-server",
        "@leav/utils": "workspace:*",
        "amqplib": "0.10.9",
        "fast-xml-parser": "5.2.5"
    },
    "stableVersion": "1.0.0"
}
