{
    "name": "portal",
    "description": "Portal application for LEAV.",
    "version": "1.6.0",
    "private": true,
    "stableVersion": "0.1.0",
    "scripts": {
        "start": "vite",
        "build": "vite build",
        "build:install": "yarn run build --outDir ../core/applications/portal --emptyOutDir",
        "build:watch": "yarn run build:install --watch",
        "test": "jest",
        "test:ci": "jest --maxWorkers=2",
        "test:commit": "jest --maxWorkers=50% --onlyChanged ",
        "graphql-generate": "graphql-codegen --config ./codegen.ts",
        "tscheck": "tsc --noEmit -p .",
        "tscheck:watch": "tsc -w --noEmit -p ."
    },
    "dependencies": {
        "@ant-design/icons": "5.2.6",
        "@apollo/client": "3.8.1",
        "@apollo/link-error": "2.0.0-beta.3",
        "@leav/ui": "workspace:libs/ui",
        "@leav/utils": "workspace:libs/utils",
        "antd": "5.22.2",
        "aristid-ds": "14.0.0-fc68ea0",
        "cross-fetch": "3.1.5",
        "graphql-ws": "5.12.0",
        "i18next": "22.5.1",
        "i18next-browser-languagedetector": "7.0.2",
        "i18next-resources-to-backend": "1.1.4",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-i18next": "12",
        "react-router-dom": "6.22.0",
        "styled-components": "6.0.8"
    },
    "devDependencies": {
        "@graphql-codegen/cli": "2.12.0",
        "@graphql-codegen/introspection": "2.2.3",
        "@graphql-codegen/typescript": "2.7.3",
        "@graphql-codegen/typescript-operations": "2.5.13",
        "@graphql-codegen/typescript-react-apollo": "3.3.7",
        "@graphql-codegen/typescript-react-query": "4.0.1",
        "@testing-library/jest-dom": "5.16.4",
        "@testing-library/react": "13.1.1",
        "@testing-library/react-hooks": "8.0.1",
        "@testing-library/user-event": "13.5.0",
        "@total-typescript/ts-reset": "0.6.1",
        "@types/jest": "27.5.2",
        "@types/node": "24.10.4",
        "@types/react": "18.2.14",
        "@types/react-dom": "18.2.6",
        "@vitejs/plugin-react": "5.1.2",
        "babel-jest": "29.7.0",
        "jest": "29.4.1",
        "jest-environment-jsdom": "29.4.1",
        "jest-fetch-mock": "3.0.3",
        "ts-jest": "29.4.6",
        "ts-jest-mock-import-meta": "1.0.0",
        "typescript": "5.5.3",
        "vite": "7.2.6",
        "vite-jest": "0.1.4",
        "vite-plugin-dynamic-base": "1.2.0"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
