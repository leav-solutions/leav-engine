{
    "name": "portal",
    "description": "Portal application for LEAV.",
    "version": "1.13.0",
    "private": true,
    "stableVersion": "0.1.0",
    "scripts": {
        "start": "vite",
        "build": "vite build",
        "build:install": "yarn run build --outDir ../core/applications/portal --emptyOutDir",
        "build:watch": "yarn run build:install --watch",
        "test": "jest",
        "test:ci": "jest --maxWorkers=2",
        "test:commit": "jest --maxWorkers=50% --onlyChanged ",
        "graphql-generate": "graphql-codegen --config ./codegen.ts",
        "tscheck": "tsc --noEmit -p .",
        "tscheck:watch": "tsc -w --noEmit -p ."
    },
    "dependencies": {
        "@ant-design/icons": "5.6.1",
        "@apollo/client": "3.14.1",
        "@apollo/link-error": "2.0.0-beta.3",
        "@leav/ui": "workspace:libs/ui",
        "@leav/utils": "workspace:libs/utils",
        "aristid-ds": "15.3.1-3917c51",
        "cross-fetch": "3.2.0",
        "graphql": "16.14.0",
        "graphql-ws": "5.16.2",
        "i18next": "22.5.1",
        "i18next-browser-languagedetector": "7.2.2",
        "i18next-resources-to-backend": "1.2.1",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-i18next": "12",
        "react-router-dom": "6.22.0",
        "styled-components": "6.0.8"
    },
    "devDependencies": {
        "@graphql-codegen/cli": "6.3.1",
        "@graphql-codegen/typescript": "5.0.10",
        "@graphql-codegen/typescript-operations": "5.1.0",
        "@graphql-codegen/typescript-react-apollo": "4.4.2",
        "@testing-library/jest-dom": "5.17.0",
        "@testing-library/react": "13.4.0",
        "@testing-library/react-hooks": "8.0.1",
        "@testing-library/user-event": "13.5.0",
        "@total-typescript/ts-reset": "0.6.1",
        "@types/jest": "27.5.2",
        "@types/node": "24.12.2",
        "@types/react": "18.2.14",
        "@types/react-dom": "18.2.6",
        "@vitejs/plugin-react": "5.2.0",
        "babel-jest": "29.7.0",
        "jest": "29.7.0",
        "jest-environment-jsdom": "29.7.0",
        "jest-fetch-mock": "3.0.3",
        "ts-jest": "29.4.9",
        "ts-jest-mock-import-meta": "1.3.2",
        "typescript": "5.9.3",
        "vite": "7.3.2",
        "vite-jest": "0.1.4",
        "vite-plugin-dynamic-base": "1.4.0"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
