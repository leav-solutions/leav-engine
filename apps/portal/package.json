{
    "name": "portal",
    "description": "Portal application for LEAV.",
    "version": "1.19.0",
    "private": true,
    "stableVersion": "0.1.0",
    "scripts": {
        "start": "vite",
        "build": "vite build",
        "build:install": "yarn run build --outDir ../core/applications/portal --emptyOutDir",
        "build:watch": "yarn run build:install --watch",
        "link:install": "ln -s ../../portal/dist ../core/applications/portal",
        "clean": "rm -rf dist tsconfig.build.tsbuildinfo tsconfig.spec.tsbuildinfo",
        "test": "vitest run -c vitest.config.ts",
        "test:ci": "vitest run -c vitest.config.ts --maxWorkers=2 --reporter=verbose",
        "test:commit": "vitest run -c vitest.config.ts --changed",
        "graphql-generate": "graphql-codegen --config ./codegen.ts",
        "tscheck": "tsc -b tsconfig.build.json && tsc --noEmit -p tsconfig.spec.json",
        "tscheck:watch": "tsc -b -w tsconfig.json"
    },
    "dependencies": {
        "@ant-design/icons": "5.6.1",
        "@apollo/client": "3.14.1",
        "@leav/ui": "workspace:libs/ui",
        "@leav/utils": "workspace:libs/utils",
        "aristid-ds": "17.1.0-63930cf",
        "cross-fetch": "3.2.0",
        "graphql": "16.14.2",
        "graphql-ws": "5.16.2",
        "i18next": "22.5.1",
        "i18next-browser-languagedetector": "7.2.2",
        "i18next-resources-to-backend": "1.2.3",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-i18next": "12",
        "react-router-dom": "6.30.4",
        "styled-components": "6.0.8"
    },
    "devDependencies": {
        "@graphql-codegen/add": "5.0.3",
        "@graphql-codegen/cli": "6.3.1",
        "@graphql-codegen/typescript": "5.0.10",
        "@graphql-codegen/typescript-operations": "5.1.0",
        "@graphql-codegen/typescript-react-apollo": "4.4.2",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "13.5.0",
        "@total-typescript/ts-reset": "0.6.1",
        "@types/node": "24.13.3",
        "@types/react": "18.3.31",
        "@types/react-dom": "18.3.7",
        "@vitejs/plugin-react": "5.2.0",
        "happy-dom": "20.11.2",
        "typescript": "7.0.2",
        "vite": "8.2.1",
        "vite-plugin-dynamic-base": "1.4.1",
        "vite-plugin-svgr": "4.5.0",
        "vitest": "4.1.10"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
