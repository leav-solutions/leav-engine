{
    "name": "data-studio",
    "description": "Generic application to manage your data",
    "version": "1.15.0",
    "private": true,
    "stableVersion": "0.1.0",
    "scripts": {
        "start": "vite",
        "build": "vite build",
        "build:install": "yarn run build --outDir ../core/applications/data-studio --emptyOutDir",
        "build:watch": "yarn run build:install --watch",
        "clean": "rm -rf dist",
        "test": "jest",
        "test:ci": "jest --maxWorkers=2",
        "test:commit": "jest --onlyChanged --maxWorkers=50%",
        "graphql-generate": "graphql-codegen --config ./codegen.ts",
        "create_comp": "scripts/createComponent.js",
        "tscheck": "tsc --noEmit -p .",
        "tscheck:watch": "tsc -w --noEmit -p ."
    },
    "dependencies": {
        "@ant-design/icons": "5.6.1",
        "@apollo/client": "3.14.1",
        "@apollo/link-error": "2.0.0-beta.3",
        "@leav/ui": "workspace:libs/ui",
        "@leav/utils": "workspace:libs/utils",
        "@reduxjs/toolkit": "1.9.7",
        "apollo-upload-client": "14.1.3",
        "aristid-ds": "15.3.1-2d7a4f8",
        "dayjs": "1.11.21",
        "graphql": "16.14.1",
        "graphql-ws": "5.16.2",
        "i18next": "22.5.1",
        "i18next-browser-languagedetector": "7.2.2",
        "i18next-resources-to-backend": "1.2.1",
        "lodash": "4.18.1",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-i18next": "12",
        "react-redux": "7.2.9",
        "react-router-dom": "6.30.4"
    },
    "devDependencies": {
        "@graphql-codegen/cli": "6.3.1",
        "@graphql-codegen/typescript": "5.0.10",
        "@graphql-codegen/typescript-operations": "5.1.0",
        "@graphql-codegen/typescript-react-apollo": "4.4.2",
        "@testing-library/jest-dom": "4.2.4",
        "@testing-library/react": "13.4.0",
        "@testing-library/user-event": "13.5.0",
        "@total-typescript/ts-reset": "0.6.1",
        "@types/jest": "27.5.2",
        "@types/lodash": "4.17.24",
        "@types/node": "24.13.1",
        "@types/react": "18.2.14",
        "@types/react-dom": "18.2.6",
        "@types/redux-mock-store": "1.5.0",
        "@types/styled-components": "5.1.36",
        "@vitejs/plugin-react": "5.2.0",
        "babel-jest": "29.7.0",
        "jest": "29.7.0",
        "jest-environment-jsdom": "29.7.0",
        "jest-fetch-mock": "3.0.3",
        "jest-styled-components": "7.4.0",
        "redux-mock-store": "1.5.5",
        "styled-components": "6.0.8",
        "ts-jest": "29.4.11",
        "ts-jest-mock-import-meta": "1.3.2",
        "typescript": "5.9.3",
        "vite": "7.3.5",
        "vite-jest": "0.1.4",
        "vite-plugin-dynamic-base": "1.4.1",
        "vite-plugin-svgr": "4.5.0"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
