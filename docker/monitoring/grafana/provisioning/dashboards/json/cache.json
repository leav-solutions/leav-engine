{
    "annotations": {
        "list": [
            {
                "builtIn": 1,
                "datasource": {
                    "type": "grafana",
                    "uid": "grafana"
                },
                "enable": true,
                "hide": true,
                "iconColor": "rgba(0, 211, 255, 1)",
                "name": "Annotations & Alerts",
                "type": "dashboard"
            }
        ]
    },
    "description": "Runtime view of the LEAV Redis cache: memoize hit ratio, compute duration, Redis command latency/errors (by db: cache vs session), and key count.",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "liveNow": false,
    "panels": [
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "id": 10,
            "title": "Overview",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "$datasource"
            },
            "description": "Share of `cachesService.memoize()` calls that skipped the compute function (value already in the per-request DataLoader or in Redis).",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "decimals": 2,
                    "max": 1,
                    "min": 0,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": 0
                            },
                            {
                                "color": "orange",
                                "value": 0.5
                            },
                            {
                                "color": "green",
                                "value": 0.8
                            }
                        ]
                    },
                    "unit": "percentunit"
                }
            },
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 1
            },
            "id": 1,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
            },
            "pluginVersion": "13.0.1",
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "$datasource"
                    },
                    "editorMode": "code",
                    "expr": "sum(rate(cache_memoize_total{k8s_namespace_name=\"$namespace\",outcome=\"hit\"}[$rate_window])) / clamp_min(sum(rate(cache_memoize_total{k8s_namespace_name=\"$namespace\"}[$rate_window])), 1e-9)",
                    "range": true,
                    "refId": "A"
                }
            ],
            "title": "Memoize hit rate",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "$datasource"
            },
            "description": "Number of `cachesService.memoize()` calls per minute, hit and miss combined.",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "decimals": 1,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "blue",
                                "value": 0
                            }
                        ]
                    },
                    "unit": "short"
