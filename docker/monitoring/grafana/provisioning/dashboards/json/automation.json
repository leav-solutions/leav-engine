{
    "annotations": {
        "list": [
            {
                "builtIn": 1,
                "datasource": {
                    "type": "grafana",
                    "uid": "grafana"
                },
                "enable": true,
                "hide": true,
                "iconColor": "rgba(0, 211, 255, 1)",
                "name": "Annotations & Alerts",
                "type": "dashboard"
            }
        ]
    },
    "description": "Runtime view of LEAV automation rules: trigger throughput, match rate, end-to-end duration and rules fetch (cache + DB) duration.",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "liveNow": false,
    "panels": [
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 0
            },
            "id": 7,
            "title": "Overview",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "$datasource"
            },
            "description": "Number of domain events evaluated by the automation engine per minute.",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "decimals": 1,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "blue",
                                "value": 0
                            }
                        ]
                    },
                    "unit": "short"
                }
            },
            "gridPos": {
                "h": 4,
                "w": 8,
                "x": 0,
                "y": 1
            },
            "id": 1,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
            },
            "pluginVersion": "13.0.1",
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "$datasource"
                    },
                    "editorMode": "code",
                    "expr": "sum(rate(automation_trigger_total{k8s_namespace_name=\"$namespace\"}[$rate_window])) * 60",
                    "range": true,
                    "refId": "A"
                }
            ],
            "title": "Triggers / min",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "$datasource"
            },
            "description": "Share of incoming events that matched at least one active automation rule.",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "decimals": 2,
                    "max": 1,
                    "min": 0,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "red",
                                "value": 0
                            },
                            {
                                "color": "orange",
                                "value": 0.01
                            },
                            {
                                "color": "green",
                                "value": 0.05
                            }
                        ]
                    },
                    "unit": "percentunit"
                }
            },
            "gridPos": {
                "h": 4,
                "w": 8,
                "x": 8,
                "y": 1
            },
            "id": 2,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
            },
            "pluginVersion": "13.0.1",
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "$datasource"
                    },
                    "editorMode": "code",
                    "expr": "sum(rate(automation_trigger_total{k8s_namespace_name=\"$namespace\",outcome=\"matched\"}[$rate_window])) / clamp_min(sum(rate(automation_trigger_total{k8s_namespace_name=\"$namespace\"}[$rate_window])), 1e-9)",
                    "range": true,
                    "refId": "A"
                }
            ],
            "title": "Match rate",
            "type": "stat"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "$datasource"
            },
            "description": "Share of trigger evaluations that ended with an error in the automation pipeline.",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "thresholds"
                    },
                    "decimals": 2,
                    "max": 1,
                    "min": 0,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": 0
                            },
                            {
                                "color": "orange",
                                "value": 0.01
                            },
                            {
                                "color": "red",
                                "value": 0.05
                            }
                        ]
                    },
                    "unit": "percentunit"
                }
            },
            "gridPos": {
                "h": 4,
                "w": 8,
                "x": 16,
                "y": 1
            },
            "id": 3,
            "options": {
                "colorMode": "value",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
                    "calcs": ["lastNotNull"],
                    "fields": "",
                    "values": false
                },
                "showPercentChange": false,
                "textMode": "auto",
                "wideLayout": true
            },
            "pluginVersion": "13.0.1",
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "$datasource"
                    },
                    "editorMode": "code",
                    "expr": "sum(rate(automation_trigger_total{k8s_namespace_name=\"$namespace\",outcome=\"error\"}[$rate_window])) / clamp_min(sum(rate(automation_trigger_total{k8s_namespace_name=\"$namespace\"}[$rate_window])), 1e-9)",
                    "range": true,
                    "refId": "A"
                }
            ],
            "title": "Error rate",
            "type": "stat"
        },
        {
            "collapsed": false,
            "gridPos": {
                "h": 1,
                "w": 24,
                "x": 0,
                "y": 5
            },
            "id": 8,
            "title": "Trigger details",
            "type": "row"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "$datasource"
            },
            "description": "Stacked rate of incoming events evaluated by automation, split by event action and outcome (matched / no_match / error).",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisBorderShow": false,
                        "axisCenteredZero": false,
                        "axisColorMode": "text",
                        "axisLabel": "",
                        "axisPlacement": "auto",
                        "barAlignment": 0,
                        "barWidthFactor": 0.6,
                        "drawStyle": "line",
                        "fillOpacity": 25,
                        "gradientMode": "none",
                        "hideFrom": {
                            "legend": false,
                            "tooltip": false,
                            "viz": false
                        },
                        "insertNulls": false,
                        "lineInterpolation": "linear",
                        "lineWidth": 1,
                        "pointSize": 5,
                        "scaleDistribution": {
                            "type": "linear"
                        },
                        "showPoints": "never",
                        "showValues": false,
                        "spanNulls": false,
                        "stacking": {
                            "group": "A",
                            "mode": "normal"
                        },
                        "thresholdsStyle": {
                            "mode": "off"
                        }
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": 0
                            },
                            {
                                "color": "red",
                                "value": 80
                            }
                        ]
                    },
                    "unit": "reqps"
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 6
            },
            "id": 4,
            "options": {
                "annotations": {
                    "clustering": -1,
                    "multiLane": false
                },
                "legend": {
                    "calcs": ["mean", "lastNotNull"],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "hideZeros": false,
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "pluginVersion": "13.0.1",
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "$datasource"
                    },
                    "editorMode": "code",
                    "expr": "sum by (event_action, outcome) (rate(automation_trigger_total{k8s_namespace_name=\"$namespace\"}[$rate_window]))",
                    "legendFormat": "{{event_action}} / {{outcome}}",
                    "range": true,
                    "refId": "A"
                }
            ],
            "title": "Triggers by event_action and outcome",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "$datasource"
            },
            "description": "Average number of rules selected from the index per incoming event. Sanity check on the index filter selectivity.",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisBorderShow": false,
                        "axisCenteredZero": false,
                        "axisColorMode": "text",
                        "axisLabel": "",
                        "axisPlacement": "auto",
                        "barAlignment": 0,
                        "barWidthFactor": 0.6,
                        "drawStyle": "line",
                        "fillOpacity": 5,
                        "gradientMode": "none",
                        "hideFrom": {
                            "legend": false,
                            "tooltip": false,
                            "viz": false
                        },
                        "insertNulls": false,
                        "lineInterpolation": "linear",
                        "lineWidth": 2,
                        "pointSize": 5,
                        "scaleDistribution": {
                            "type": "linear"
                        },
                        "showPoints": "never",
                        "showValues": false,
                        "spanNulls": false,
                        "stacking": {
                            "group": "A",
                            "mode": "none"
                        },
                        "thresholdsStyle": {
                            "mode": "off"
                        }
                    },
                    "decimals": 2,
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": 0
                            },
                            {
                                "color": "red",
                                "value": 80
                            }
                        ]
                    },
                    "unit": "short"
                }
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 6
            },
            "id": 5,
            "options": {
                "annotations": {
                    "clustering": -1,
                    "multiLane": false
                },
                "legend": {
                    "calcs": ["mean", "max"],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "hideZeros": false,
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "pluginVersion": "13.0.1",
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "$datasource"
                    },
                    "editorMode": "code",
                    "expr": "sum by (event_action) (rate(automation_trigger_rules_matched_sum{k8s_namespace_name=\"$namespace\"}[$rate_window])) / clamp_min(sum by (event_action) (rate(automation_trigger_rules_matched_count{k8s_namespace_name=\"$namespace\"}[$rate_window])), 1e-9)",
                    "legendFormat": "{{event_action}}",
                    "range": true,
                    "refId": "A"
                }
            ],
            "title": "Mean rules matched per event",
            "type": "timeseries"
        },
        {
            "datasource": {
                "type": "prometheus",
                "uid": "$datasource"
            },
            "description": "p95 latency of triggerRules — `total` covers everything (cache + DB + pipeline executions), `fetch only` isolates the cache + DB layer. The gap between the two indicates the share of cost due to pipeline execution.",
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "axisBorderShow": false,
                        "axisCenteredZero": false,
                        "axisColorMode": "text",
                        "axisLabel": "",
                        "axisPlacement": "auto",
                        "barAlignment": 0,
                        "barWidthFactor": 0.6,
                        "drawStyle": "line",
                        "fillOpacity": 0,
                        "gradientMode": "none",
                        "hideFrom": {
                            "legend": false,
                            "tooltip": false,
                            "viz": false
                        },
                        "insertNulls": false,
                        "lineInterpolation": "linear",
                        "lineWidth": 2,
                        "pointSize": 5,
                        "scaleDistribution": {
                            "type": "linear"
                        },
                        "showPoints": "never",
                        "showValues": false,
                        "spanNulls": false,
                        "stacking": {
                            "group": "A",
                            "mode": "none"
                        },
                        "thresholdsStyle": {
                            "mode": "off"
                        }
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": 0
                            },
                            {
                                "color": "red",
                                "value": 80
                            }
                        ]
                    },
                    "unit": "ms"
                }
            },
            "gridPos": {
                "h": 8,
                "w": 24,
                "x": 0,
                "y": 14
            },
            "id": 6,
            "options": {
                "annotations": {
                    "clustering": -1,
                    "multiLane": false
                },
                "legend": {
                    "calcs": ["mean", "max"],
                    "displayMode": "table",
                    "placement": "bottom",
                    "showLegend": true
                },
                "tooltip": {
                    "hideZeros": false,
                    "mode": "multi",
                    "sort": "desc"
                }
            },
            "pluginVersion": "13.0.1",
            "targets": [
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "$datasource"
                    },
                    "editorMode": "code",
                    "expr": "histogram_quantile(0.95, sum by (le, event_action, synchronous) (rate(automation_trigger_duration_milliseconds_bucket{k8s_namespace_name=\"$namespace\"}[$rate_window])))",
                    "legendFormat": "total {{event_action}} sync={{synchronous}}",
                    "range": true,
                    "refId": "A"
                },
                {
                    "datasource": {
                        "type": "prometheus",
                        "uid": "$datasource"
                    },
                    "editorMode": "code",
                    "expr": "histogram_quantile(0.95, sum by (le, event_action, synchronous) (rate(automation_trigger_rules_fetch_duration_milliseconds_bucket{k8s_namespace_name=\"$namespace\"}[$rate_window])))",
                    "legendFormat": "fetch only {{event_action}} sync={{synchronous}}",
                    "range": true,
                    "refId": "B"
                }
            ],
            "title": "Trigger duration p95 — total vs rules_fetch",
            "type": "timeseries"
        }
    ],
