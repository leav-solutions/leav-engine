{
    "name": "leav-monorepo",
    "version": "1.12.0-3",
    "private": true,
    "workspaces": {
        "packages": [
            "apps/*",
            "libs/*",
            "test-apps/*"
        ]
    },
    "scripts": {
        "fronts:build:install": "yarn workspaces foreach -v -A --include 'apps/*' run build:install",
        "fronts:graphql-generate": "yarn workspaces foreach -v -A run graphql-generate",
        "test": "CI=true node ./scripts/testChangedProjects.js",
        "test:ci": "",
        "lint": "eslint --ext=ts,tsx --fix apps/ libs/ test-apps/",
        "lint:check": "eslint --ext=ts,tsx apps/ libs/ test-apps/",
        "prettier:fix": "prettier --write",
        "prettier:fix:all": "prettier --write .",
        "prettier:check": "prettier --check .",
        "format:all": "yarn prettier && yarn lint",
        "tscheck": "yarn workspaces foreach -vpA --exclude 'libs/types' run tscheck",
        "license:check": "license-check-and-add check -f license-check-config.json",
        "license:add": "license-check-and-add add -f license-check-config.json",
        "license:remove": "license-check-and-add remove -f license-check-config.json",
        "translations:check": "node ./scripts/compareTranslations.js",
        "postinstall": "husky install",
        "commit": "cz"
    },
    "dependencies": {
        "@rushstack/eslint-patch": "1.16.1",
        "eslint": "8.57.1",
        "prettier": "3.3.3",
        "react-router-dom": "6.22.0",
        "typescript": "5.9.3"
    },
    "devDependencies": {
        "@aristid/eslint-plugin": "1.3.0",
        "@babel/preset-env": "7.29.0",
        "@commitlint/cli": "19.8.1",
        "@commitlint/config-conventional": "19.8.1",
        "@types/babel__preset-env": "^7",
        "@types/jest": "29.5.14",
        "@types/testing-library__jest-dom": "5.14.9",
        "@typescript-eslint/eslint-plugin": "7.18.0",
        "@typescript-eslint/parser": "7.18.0",
        "commitizen": "4.3.1",
        "cz-conventional-changelog": "3.3.0",
        "eslint-formatter-gitlab": "5.1.0",
        "eslint-plugin-import": "2.32.0",
        "eslint-plugin-jsdoc": "39.9.1",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-no-only-tests": "3.3.0",
        "eslint-plugin-react-hooks": "4.4.0",
        "eslint-plugin-react-refresh": "0.4.26",
        "husky": "6.0.0",
        "jest-watch-typeahead": "2.2.2",
        "license-check-and-add": "3.0.5",
        "lint-staged": "16.4.0"
    },
    "resolutions": {
        "nwsapi": "2.2.7",
        "fs-capacitor": "6.2.0",
        "data-studio:babel-jest": "26",
        "data-studio:jest": "26.6.0",
        "react-error-overlay": "6.1.0",
        "@types/react": "^16",
        "@types/react-dom": "^16",
        "semver": "7.7.4",
        "git-url-parse": "13",
        "glob-parent": ">=5.1.2",
        "node-fetch": "2.6.7",
        "@types/express": ">=4.17.21",
        "ts-jest": "29.4.6"
    },
    "lint-staged": {
        "*": [
            "prettier --write",
            "license-check-and-add add -f license-check-config.json"
        ],
        "*.{ts,js,tsx,jsx}": [
            "eslint --fix"
        ]
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "yarn@4.13.0",
    "stableVersion": "0.0.0",
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    }
}
