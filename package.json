{
    "name": "leav-monorepo",
    "version": "1.17.0",
    "private": true,
    "workspaces": {
        "packages": [
            "apps/*",
            "libs/*",
            "test-apps/*"
        ]
    },
    "scripts": {
        "fronts:build:install": "yarn workspaces foreach -v -A --include 'apps/*' run build:install",
        "fronts:graphql-generate": "yarn workspaces foreach -v -A run graphql-generate",
        "test": "CI=true node ./scripts/testChangedProjects.js",
        "test:ci": "",
        "lint": "eslint --fix apps libs test-apps",
        "lint:check": "eslint apps libs test-apps",
        "prettier:fix": "prettier --write",
        "prettier:fix:all": "prettier --write .",
        "prettier:check": "prettier --check .",
        "format:all": "yarn prettier:fix:all && yarn lint",
        "tscheck": "yarn workspaces foreach -vpA --exclude 'libs/core-types' run tscheck",
        "clean": "yarn workspaces foreach -vpA run clean",
        "translations:check": "node ./scripts/compareTranslations.js",
        "postinstall": "husky install",
        "commit": "cz"
    },
    "devDependencies": {
        "@aristid/eslint-plugin": "2.2.1",
        "@babel/preset-env": "7.29.7",
        "@commitlint/cli": "19.8.1",
        "@commitlint/config-conventional": "19.8.1",
        "@types/babel__preset-env": "^7",
        "@types/jest": "29.5.14",
        "@types/testing-library__jest-dom": "5.14.9",
        "commitizen": "4.3.2",
        "cz-conventional-changelog": "3.3.0",
        "eslint": "9.39.4",
        "eslint-formatter-gitlab": "5.1.0",
        "eslint-plugin-no-only-tests": "3.4.0",
        "husky": "6.0.0",
        "jest-watch-typeahead": "2.2.2",
        "lint-staged": "16.4.0",
        "prettier": "3.9.1",
        "typescript": "5.9.3"
    },
    "resolutions": {
        "nwsapi": "2.2.7",
        "fs-capacitor": "6.2.0",
        "data-studio:babel-jest": "26",
        "data-studio:jest": "26.6.0",
        "react-error-overlay": "6.1.0",
        "@types/react": "18.2.14",
        "@types/react-dom": "18.2.14",
        "semver": ">=7.8.0",
        "uuid": "^14",
        "sha.js": ">=2.4.12",
        "git-url-parse": "13",
        "glob-parent": ">=5.1.2",
        "@types/express": ">=4.17.21",
        "ts-jest": "29.4.11",
        "@elastic/transport:undici": "^6.25.0",
        "minimatch@^3.0.4": "^3.1.5",
        "minimatch@^3.0.5": "^3.1.5",
        "minimatch@^3.1.1": "^3.1.5",
        "minimatch@^3.1.2": "^3.1.5"
    },
    "lint-staged": {
        "*": [
            "prettier --write"
        ],
        "*.{ts,tsx}": [
            "eslint --fix"
        ]
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "yarn@4.17.0",
    "stableVersion": "0.0.0",
    "config": {
        "commitizen": {
            "path": "./node_modules/cz-conventional-changelog"
        }
    }
}
