#!/bin/sh
branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$branch" = "develop" ] || [ "$branch" = "main" ]; then
  echo "Cannot commit to develop and main branches directly. Please create a pull request."
  exit 1
fi

export SKIP_PREFLIGHT_CHECK=true
export CI=true

echo "Checking translations files"
yarn translations:check

# TypeScript check is disabled by default (can be slow)
# To enable it locally, set: export RUN_TSCHECK=true in your ~/.bashrc or ~/.zshrc
if [ "$RUN_TSCHECK" = "true" ]; then
  echo "\n Checking types..."
  yarn run tscheck
else
  echo "\n Skipping type check (set RUN_TSCHECK=true to enable)"
fi

echo "\n Checking staged files..."
yarn lint-staged
